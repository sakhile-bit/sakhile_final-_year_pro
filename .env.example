# Development Environment Variables
# Copy this to .env and update values for your setup

# Flask & Security
DEBUG=false
SECRET_KEY=your-secret-key-here

# Database (MySQL)
# For production; SQLite is default if not configured
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_hygiene
DB_USER=root
DB_PASSWORD=yourpassword

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Web Server
WEB_HOST=127.0.0.1
WEB_PORT=5000
